{
  "realm": "order-management",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Customer can create and read their own orders"
      },
      {
        "name": "SUPPORT",
        "description": "Support can read orders across customers"
      },
      {
        "name": "ADMIN",
        "description": "Admin can read all orders and update order status"
      }
    ]
  },
  "clients": [
    {
      "clientId": "order-management-api",
      "name": "Order Management API",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "order-management-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "order-management-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer1",
      "enabled": true,
      "email": "customer1@example.com",
      "firstName": "Customer",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "customer2",
      "enabled": true,
      "email": "customer2@example.com",
      "firstName": "Customer",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "support1",
      "enabled": true,
      "email": "support1@example.com",
      "firstName": "Support",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["SUPPORT"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    }
  ]
}
