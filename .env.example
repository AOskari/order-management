# Copy this file to .env for local development. It is loaded by application-local.yaml
# (the local default profile) as a properties file: keep KEY=value lines and # comments.
POSTGRES_PASSWORD=postgres
DB_PORT=5432
APP_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/order_management
DB_APP_USER=oms_app
DB_APP_PASSWORD=change-me-app
DB_OWNER_USER=oms_owner
DB_OWNER_PASSWORD=change-me-owner
# Public URL of the Keycloak container. host.docker.internal resolves to the Docker host,
# so the host and the application container can use the same issuer.
KEYCLOAK_URL=http://host.docker.internal:8081
OIDC_ISSUER_URI=http://host.docker.internal:8081/realms/order-management
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
